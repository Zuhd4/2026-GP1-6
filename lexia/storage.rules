rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Reading Books
    match /reading_books/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Word Images
    match /word_images/{allPaths=**} {
      allow read: if true;
    }

   
  // Documents sent from Parent to Child
  match /users/{parentId}/children/{childId}/sharedDocuments/{fileName} {

    // Parent can read and upload documents.
    allow read: if request.auth != null
      && (
        request.auth.uid == parentId
        || (
          request.auth.token.role == 'child'
          && request.auth.token.parentUid == parentId
          && request.auth.token.childId == childId
        )
      );

    // Only the parent can upload or delete documents.
    allow write: if request.auth != null
      && request.auth.uid == parentId;
  }


    // NEW: Documents saved by Parent
    match /users/{parentId}/parentDocuments/{fileName} {
      allow read, write: if request.auth != null
                         && request.auth.uid == parentId;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}