
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================
    // AUTHENTICATION HELPERS
    // =====================================


function isParent(parentId) {
  return request.auth != null
    && parentId != '_familyCodeRegistry'
    && request.auth.uid == parentId
    && request.auth.token.get('role', '') != 'child'
    && request.auth.token.firebase.sign_in_provider == 'password';
}


    function isChild(parentId, childId) {
      return request.auth != null
        && request.auth.token.role == 'child'
        && request.auth.token.parentUid == parentId
        && request.auth.token.childId == childId;
    }

    function protectedPinFields() {
      return [
        'picturePinSalt',
        'picturePinDigest',
        'picturePinAuth',
        'picturePinEnabled',
        'picturePinUpdatedAt'
      ];
    }

    function protectedFamilyFields() {
      return [
        'familyCode',
        'familyCodeCreatedAt',
        'familyCodeLastResetAt'
      ];
    }

    // =====================================
    // VOCABULARY TEST
    // =====================================

    match /vocabulary_test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // =====================================
    // VOCABULARY
    // =====================================

    match /vocabulary/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // =====================================
    // PRIVATE FAMILY CODE REGISTRY
    // =====================================

    match /users/_familyCodeRegistry {
      allow read, write: if false;

      match /codes/{codeId} {
        allow read, write: if false;
      }

      match /lookupAttempts/{attemptId} {
        allow read, write: if false;
      }
    }

    // =====================================
    // PARENT ACCOUNTS
    // =====================================

    match /users/{userId} {

      // Parent can read their own account.
      allow get: if isParent(userId);

      // Do not allow listing parent accounts.
      allow list: if false;

      // Parent can create their profile.
      // Family Codes are generated by Cloud Functions.
      allow create: if isParent(userId)
        && !request.resource.data.keys()
          .hasAny(protectedFamilyFields());

      // Parent can update ordinary account settings.
      allow update: if isParent(userId)
        && !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(protectedFamilyFields());

      allow delete: if false;

      // =====================================
      // PARENT DOCUMENTS
      // =====================================

      match /parentDocuments/{documentId} {
        allow read, write: if isParent(userId);
      }

      // =====================================
      // CHILD PROFILES
      // =====================================

      match /children/{childId} {

        // Parent can access all their children.
        // Child can access only their own profile.
        allow get: if isParent(userId)
          || isChild(userId, childId);

        // Parents can list their children.
        allow list: if isParent(userId);

        // Parent creates the child profile.
        // The Cloud Function stores the picture PIN.
        allow create: if isParent(userId)
          && !request.resource.data.keys()
            .hasAny(protectedPinFields());

        // Parent can update child settings,
        // except protected PIN verification fields.
        allow update: if (
          isParent(userId)
          && !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(protectedPinFields())
        ) || (
          isChild(userId, childId)
&& request.resource.data.diff(resource.data)
  .affectedKeys().hasOnly([
    'gameProgress',
    'readingProgress',
    'name',
    'avatarUrl',
    'updatedAt'
  ])
        );

        allow delete: if isParent(userId);

// =====================================
// PRIVATE CHILD AUTHENTICATION
// =====================================
match /privateAuth/{authDocId} {
  allow read, write: if false;
}


        // =====================================
        // DOCUMENTS SHARED WITH CHILDREN
        // =====================================

        match /sharedDocuments/{documentId} {

          allow read: if isParent(userId)
            || isChild(userId, childId);

          allow write: if isParent(userId);
        }
      }
    }

    // =====================================
    // READING BOOKS
    // =====================================

    match /reading_books/{bookId} {

      allow read: if true;
      allow write: if false;

      match /pages/{pageId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // All unspecified paths are denied by default.
  }
}
